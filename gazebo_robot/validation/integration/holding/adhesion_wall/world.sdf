          <xyz>0 1 0</xyz>
          <dynamics>
            <damping>0.0001</damping>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="libMagneticRobot.so" name="magnetic_robot::MagneticAdhesion">
        <force_per_wheel>200.0</force_per_wheel>
        <capture_gap>0.0005</capture_gap>
        <release_gap>0.001</release_gap>
        <default_surface_model>bridge</default_surface_model>
        <default_surface_file>surfaces/bridge.stl</default_surface_file>
        <surface>
          <model>steel_plate</model>
          <file>surfaces/plate.stl</file>
        </surface>
      </plugin>
      <plugin filename="libMagneticRobot.so" name="magnetic_robot::SteeringLimitMonitor">
        <hard_limit>0.2617993877991494</hard_limit>
      </plugin>
      <pose>0.0316 0 7.01660951563099e-18 0 1.570796326794897 0</pose>
      <plugin filename="libMagneticRobot.so" name="magnetic_robot::RobotDriveController">
        <rpm>15.0</rpm>
        <steer_deg>14.0</steer_deg>
        <rpm_slew>30.0</rpm_slew>
        <steer_slew_deg>30.0</steer_slew_deg>
        <wheel_torque>0.8</wheel_torque>
        <steer_torque>5.0</steer_torque>
        <wheel_kp>0.08</wheel_kp>
        <wheel_ki>0.8</wheel_ki>
        <steer_kp>60.0</steer_kp>
        <steer_kd>1.0</steer_kd>
        <steer_ki>60.0</steer_ki>
        <timeout>0.25</timeout>
      </plugin>
    </model>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>