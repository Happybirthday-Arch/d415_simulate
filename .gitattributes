# 二进制资产：禁止行尾转换、按二进制处理，避免 diff 撑爆仓库
*.stl   binary
*.STL   binary
*.STEP  binary
*.step  binary
*.SLDPRT binary
*.png   binary
*.PNG   binary
*.jpg   binary
*.svg   -text -diff
*.db3   binary
*.npy   binary
*.zip   binary

# 文本文件统一 LF，Windows 检出为 CRLF
* text=auto eol=lf
*.sdf   text eol=lf
*.xacro text eol=lf
*.world text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
